rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in admin account may read or write business data
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'umeshfencingworks@gmail.com';
    }
  }
}
