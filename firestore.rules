rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Umesh Fencing Works - Security Rules
    // Strictly enforces that only the authorized administrator (umeshfencingworks@gmail.com)
    // can read and write business-critical data (documents, customers, payments, ledgers, etc.)

    function isAuthorizedAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'umeshfencingworks@gmail.com' ||
         request.auth.token.email_verified == true && request.auth.token.email.lower() == 'umeshfencingworks@gmail.com');
    }

    // Core business collections
    match /customers/{customerId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /documents/{documentId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /payments/{paymentId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read, write: if isAuthorizedAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAuthorizedAdmin();
    }
    
    match /counters/{counterId} {
      allow read, write: if isAuthorizedAdmin();
    }

    match /materials/{materialId} {
      allow read, write: if isAuthorizedAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAuthorizedAdmin();
    }

    match /purchase ledger/{purchaseId} {
      allow read, write: if isAuthorizedAdmin();
    }

    match /scrapEntries/{scrapId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // User profiles & auth checks
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAuthorizedAdmin();
    }
  }
}
